# ==============================================================================
# TERRASENSE BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# 1. SUPABASE DATABASE (Already configured if your app is working!)
SUPABASE_URL=https://ofmtsdzsbbwbexbzdvrl.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# CORS CONFIGURATION
FRONTEND_URL=https://your-frontend.vercel.app

# 2. AWS SNS HACKATHON INTEGRATION
# Deploy `aws/sns_alerts_template.yaml` to AWS CloudFormation to get this ARN
AWS_SNS_TOPIC_ARN=arn:aws:sns:REGION:ACCOUNT-ID:TerraSense-CriticalAlerts

# AWS Credentials (Required if you don't have the AWS CLI configured globally)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# 3. AI PROVIDERS (For Terra AI & Agents)
# Add your keys here if you are using real LLMs instead of deterministic scoring
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
